# Supabase (project: demonic-search, gsoiexqtaiyjepzqyfso)
# There are no accounts — every request runs through the service-role client,
# so only the project URL and the service role key are needed.
NEXT_PUBLIC_SUPABASE_URL=https://gsoiexqtaiyjepzqyfso.supabase.co
# Service role key: from Supabase dashboard → Project Settings → API. Server-only, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Model gateway (NVIDIA NIM, OpenAI-compatible)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Fallback provider
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Research tool: Seekly (search.amatip.com), a self-hosted Tavily-shaped search API.
# SEEKLY_API_URL defaults to https://search.amatip.com; set it only to point at a
# different deployment (e.g. self-hosting Seekly yourself).
SEEKLY_API_KEY=
SEEKLY_API_URL=

# Codebase picker (optional). With a token, the picker lists that account's repos
# (private ones included) and the agent can read them; without one, it lists
# GITHUB_OWNER's public repos and any public owner/repo can be typed in.
GITHUB_TOKEN=
GITHUB_OWNER=
# Optional: encrypts the GitHub account connected on /access/github (main key only).
# Defaults to a key derived from SUPABASE_SERVICE_ROLE_KEY; changing either means reconnecting.
GITHUB_TOKEN_SECRET=

# Time budget for one agent invocation, in ms. Keep ~30s under the route's
# maxDuration (300s); a longer turn pauses and resumes automatically.
TURN_BUDGET_MS=270000

# Visual check (optional): path to a Chromium binary for local development.
# On Vercel the bundled @sparticuz/chromium is used; locally Playwright's installed browser.
CHROMIUM_PATH=
